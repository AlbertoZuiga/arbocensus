# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=arbocensus.tudominio.cl
CSRF_TRUSTED_ORIGINS=https://arbocensus.tudominio.cl

# ── Database (settings.py uses DB_* variables, not DATABASE_URL) ──────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=arbocensus
DB_USER=arbocensus
DB_PASSWORD=change-me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OSRM ──────────────────────────────────────────────────────────────────────
OSRM_URL=http://osrm:5000
# Name of the .osm.pbf file (without extension) inside data/osm/
OSM_REGION=santiago

# ── Legacy databases (read-only) ──────────────────────────────────────────────
# Required by the "Importar legado" admin screen. Left empty, that screen returns
# 503 and the rest of the app works normally.
ARBOCENSUS_API_DB_URL=
ARBOCENSUS_DB_URL=

# ── CORS (empty = same-origin, which is the production default) ───────────────
CORS_ALLOWED_ORIGINS=

# ── Superuser created on first boot (idempotent) ──────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ── Caddy ─────────────────────────────────────────────────────────────────────
# Use a real domain for automatic TLS, or <IP>.sslip.io while domain is pending
SITE_ADDRESS=arbocensus.tudominio.cl

# ── GHCR image coordinates ────────────────────────────────────────────────────
GHCR_OWNER=albertozuiga
IMAGE_TAG=production
